CHEMO_PRODUCT_ENVIRONMENT=local
CHEMO_PRODUCT_HOST=127.0.0.1
CHEMO_PRODUCT_PORT=8011
CHEMO_PRODUCT_DATABASE_URL=
# Optional: a separate database whose name contains "test"; only TEST_ONLY synthetic contexts are readable.
CHEMO_PRODUCT_RUNTIME_TEST_DATABASE_URL=

# Model service: fill locally when funded; never put these values in frontend code.
CHEMO_PRODUCT_MODEL_ENABLED=false
CHEMO_PRODUCT_MODEL_API_KEY=
CHEMO_PRODUCT_MODEL_BASE_URL=
CHEMO_PRODUCT_MODEL_NAME=
CHEMO_PRODUCT_REVIEWER_MODEL_NAME=
CHEMO_PRODUCT_MODEL_TIMEOUT_SECONDS=120
CHEMO_PRODUCT_MODEL_MAX_TURNS=8
CHEMO_PRODUCT_MODEL_MAX_BUDGET_USD=0.5

# Local/test identity contract only; production hospital authentication is separate.
CHEMO_PRODUCT_LAUNCH_SIGNING_KEY=
CHEMO_PRODUCT_TRUSTED_HOST_ORIGINS=[]
CHEMO_PRODUCT_HOSPITAL_ADAPTER_CONFIG=
CHEMO_PRODUCT_HOSPITAL_DELIVERY_CONFIG=
CHEMO_PRODUCT_CONTEXT_TTL_SECONDS=1800
CHEMO_PRODUCT_WORKER_POLL_SECONDS=1
CHEMO_PRODUCT_WORKER_LEASE_SECONDS=180
CHEMO_PRODUCT_WORKER_RESTART_MAX_SECONDS=30

# Safe JSON logs: separate files per environment; never commit local logs.
CHEMO_PRODUCT_LOG_LEVEL=INFO
CHEMO_PRODUCT_LOG_DIRECTORY=logs
CHEMO_PRODUCT_LOG_TO_FILE=true
CHEMO_PRODUCT_LOG_MAX_BYTES=10485760
CHEMO_PRODUCT_LOG_BACKUP_COUNT=5
